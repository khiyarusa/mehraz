{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mehraz/content-catalog/1",
  "title": "MEHRAZ content catalogue",
  "description": "Contract between the phase-01 shell and the phase-02 educational content. The same structure is embedded into start.html at build time as window.MEHRAZ_CONTENT. Validation is performed at runtime by src/scripts/content.js; an invalid catalogue is rejected as a whole and the app falls back to an empty catalogue.",
  "type": "object",
  "required": ["schemaVersion", "books"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "generator": { "type": "string" },
    "books": { "type": "array", "items": { "$ref": "#/$defs/book" } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Stable, opaque identifier. Progress records reference these ids and must never be rewritten when a new edition is published."
    },
    "source": {
      "type": "object",
      "description": "Traceability record. Required for every content item that makes a factual claim.",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["textbook", "curriculum", "reference", "demo"]
        },
        "publisher": { "type": "string", "description": "e.g. organization that published the official textbook" },
        "title": { "type": "string" },
        "academicYear": { "type": "string", "description": "Persian academic year, e.g. 1405-1406" },
        "edition": { "type": "string", "description": "Print run / edition identifier. A new edition is a new value, never an overwrite." },
        "isbn": { "type": "string" },
        "url": { "type": "string", "description": "Documentation only; the runtime never fetches it." },
        "reference": { "type": "string", "description": "Human readable locator, e.g. chapter 2, page 34" },
        "pages": { "type": "string" },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "verifiedBy": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "description": "Key from the built-in icon set." }
      }
    },
    "objective": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "bloom": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        }
      }
    },
    "block": {
      "type": "object",
      "description": "Renderer-supported content blocks. Unknown block types are ignored rather than executed.",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["p", "list", "note", "formula", "figure", "table"] },
        "text": { "type": "string", "description": "Paragraph, note and formula body. Formula text is rendered escaped as plain text; no markup is interpreted." },
        "note": { "type": "string", "description": "formula only: optional explanatory note rendered under the formula." },
        "items": { "type": "array", "items": { "type": "string" } },
        "tone": { "type": "string", "enum": ["info", "warn"] },
        "src": { "type": "string", "description": "Inline data: URI only. Remote URLs are rejected at render time." },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "head": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "section": {
      "type": "object",
      "required": ["blocks"],
      "properties": {
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "animation": {
      "type": "object",
      "description": "Declarative specification only. Phase 02 implementations must stay inside the bundled CSS/SVG motion vocabulary.",
      "properties": {
        "kind": { "type": "string", "enum": ["none", "css", "svg"] },
        "preset": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "description": "Interactive demonstration or experiment.",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["simulation", "game", "experiment", "widget"] },
        "title": { "type": "string" },
        "instructions": { "type": "string" },
        "embed": {
          "type": "string",
          "enum": ["css", "svg", "canvas", "dom"],
          "description": "Implementation technology. No external runtime may be introduced."
        },
        "component": { "type": "string", "description": "Registered renderer key, resolved from the bundled component registry." },
        "config": { "type": "object" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["mcq", "truefalse", "multi", "numeric"] },
        "prompt": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 8 },
        "correct": {
          "description": "mcq: [index] or index; truefalse: 'true' | 'false'; multi: array of indexes",
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            { "type": "string", "enum": ["true", "false"] }
          ]
        },
        "answer": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "explanation": { "type": "string" },
        "topicId": { "$ref": "#/$defs/id" },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "points": { "type": "number", "minimum": 0 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "exam": {
      "type": "object",
      "required": ["id", "title", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "durationMinutes": { "type": ["integer", "null"], "minimum": 1 },
        "passPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "minutes": { "type": "integer", "minimum": 0 },
        "pageFrom": { "type": ["integer", "null"] },
        "pageTo": { "type": ["integer", "null"] },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" } },
        "sections": {
          "type": "object",
          "description": "Keys must be one of: intro, objectives, explanation, keyConcepts, examples, illustrations, interactive, exercises, summary, references",
          "additionalProperties": { "$ref": "#/$defs/section" }
        },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "animation": { "$ref": "#/$defs/animation" },
        "instructionalDesign": {
          "type": "object",
          "description": "Authoring metadata for lesson design. Optional and never rendered to students; available read-only through MEHRAZ.content.",
          "properties": {
            "topicType": { "type": "string" },
            "prerequisites": { "type": "array", "items": { "type": "string" } },
            "likelyMisconceptions": { "type": "array", "items": { "type": "string" } },
            "primaryStrategy": { "type": "string" },
            "supportingStrategies": { "type": "array", "items": { "type": "string" } },
            "narrativeTheme": { "type": "string" },
            "visualStrategy": { "type": "string" },
            "interactionStrategy": { "type": "string" },
            "assessmentStrategy": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["draft", "reviewed", "verified"] },
            "checkedAt": { "type": ["string", "null"] },
            "checkedBy": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "pageFrom": { "type": ["integer", "null"] },
        "pageTo": { "type": ["integer", "null"] },
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
        "exams": { "type": "array", "items": { "$ref": "#/$defs/exam" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "book": {
      "type": "object",
      "required": ["id", "title", "grade", "subject", "chapters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "grade": { "type": "integer", "enum": [7, 8, 9, 10, 11, 12] },
        "track": {
          "type": ["string", "null"],
          "enum": ["math", "experimental", "humanities", null],
          "description": "null for grades 7-9."
        },
        "subject": { "$ref": "#/$defs/subject" },
        "academicYear": { "type": "string" },
        "edition": { "type": "string" },
        "volume": { "type": ["integer", "null"] },
        "demo": { "type": "boolean", "description": "Structural demo only. Never set for real content." },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
        "exams": { "type": "array", "items": { "$ref": "#/$defs/exam" } },
        "verification": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["draft", "reviewed", "verified"] },
            "checkedAt": { "type": ["string", "null"] },
            "checkedBy": { "type": ["string", "null"] }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
